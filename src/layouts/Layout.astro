---
import "../styles/global.css"

interface Props {
	title: string
	description: string
	type?: "website" | "article"
	publishedTime?: string
}

const { title, description, type = "website", publishedTime } = Astro.props
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="aigic8 blog" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<title>{title}</title>
	</head>
	<body class="bg-paper text-ink min-h-screen font-mono antialiased">
		<div class="mx-auto flex min-h-screen max-w-3xl flex-col px-6 pt-10 pb-16">
			<slot />
		</div>
	</body>
</html>
