---
import { getCollection, render } from "astro:content"
import type { CollectionEntry } from "astro:content"
import Layout from "../../layouts/Layout.astro"

export async function getStaticPaths(): Promise<CollectionEntry<"posts">[]> {
	const posts = await getCollection("posts")
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}))
}

interface Props {
	post: CollectionEntry<"posts">
}

const { post } = Astro.props
const { Content } = await render(post)

const formatDate = (date: Date): string =>
	date
		.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })
		.toUpperCase()
---

<Layout
	title={`${post.data.title} · aigic8 blog`}
	description={post.data.description}
	type="article"
	publishedTime={post.data.pubDate.toISOString()}
>
	<header class="border-ink/25 bg-paper/90 fixed inset-x-0 top-0 z-10 border-b backdrop-blur-sm">
		<div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-3">
			<h1 class="text-lg font-bold tracking-tight uppercase sm:text-xl"><a href="/">aigic8 blog</a></h1>
			<nav class="flex gap-6 text-sm uppercase sm:text-base">
				<a href="/#posts" class="hover:bg-ink hover:text-paper -mx-2 px-2">posts</a>
				<a href="/#notes" class="hover:bg-ink hover:text-paper -mx-2 px-2">notes</a>
			</nav>
		</div>
	</header>

	<article class="pt-24 pb-16">
		<p class="text-muted text-xs">{formatDate(post.data.pubDate)}</p>
		<h2 class="text-text text-4xl leading-snug font-bold sm:text-5xl">{post.data.title}</h2>
		<p class="text-ink mt-3 text-sm leading-7">{post.data.description}</p>
		<div
			class="prose prose-invert prose-headings:font-bold prose-headings:uppercase prose-headings:text-text prose-p:text-text prose-strong:text-text prose-code:text-text prose-a:[color:#ca98f3] prose-li:text-text mt-8 max-w-none"
		>
			<Content />
		</div>
	</article>
</Layout>
